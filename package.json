{
  "name": "starchild-designer-handoff",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src scripts vite.config.ts",
    "export:html": "node scripts/export-single-file.mjs",
    "deploy:pages": "node scripts/deploy-pages.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@types/node": "22.16.5",
    "@vitejs/plugin-react": "5.0.4",
    "vite": "7.3.1",
    "typescript": "5.8.3",
    "esbuild": "0.28.1",
    "prettier": "3.7.3",
    "tailwindcss": "4.2.1"
  }
}
